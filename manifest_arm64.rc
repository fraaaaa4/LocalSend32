#include <windows.h>

101 ICON "LocalSend.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // US English, Unicode charset
        BEGIN
            VALUE "CompanyName",      "Fratta"
            VALUE "FileDescription",  "LocalSend client built with C/Win32 APIs"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "LocalSend"
            VALUE "OriginalFilename", "LocalSend64_ARM.exe"
            VALUE "ProductName",      "LocalSend ARM64"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 24 "LocalSend.manifest"
