#include <windows.h>

101 ICON "LocalSend.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // US English, Unicode charset
        BEGIN
            VALUE "CompanyName",      "Fratta"
            VALUE "FileDescription",  "LocalSend client built with C/Win32 APIs"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "LocalSend"
            VALUE "OriginalFilename", "LocalSendRT.exe"
            VALUE "ProductName",      "LocalSend RT"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 24 MOVEABLE PURE
BEGIN
    "<?xml version=""1.0"" encoding=""UTF-8"" standalone=""yes""?>\r\n"
    "<assembly xmlns=""urn:schemas-microsoft-com:asm.v1"" manifestVersion=""1.0"">\r\n"
    "  <assemblyIdentity version=""2.0.0.0"" processorArchitecture=""arm"" name=""LocalSendRT"" type=""win32"" />\r\n"
    "  <description>LocalSend Native Client for Windows RT</description>\r\n"
    "  <dependency>\r\n"
    "    <dependentAssembly>\r\n"
    "      <assemblyIdentity type=""win32"" name=""Microsoft.Windows.Common-Controls"" version=""6.0.0.0"" processorArchitecture=""arm"" publicKeyToken=""6595b64144ccf1df"" language=""*"" />\r\n"
    "    </dependentAssembly>\r\n"
    "  </dependency>\r\n"
    "</assembly>\r\n"
END
